{
	"name": "extended-file-support",
	"version": "1.4.1",
	"description": "Extended file support for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev:pureref-vault": "npm run build && node scripts/pureref-vault.mjs",
		"test:pureref:obsidian": "node scripts/test-pureref-obsidian.mjs",
		"test:pureref": "playwright test --config tests/pureref/playwright.config.mjs",
		"test:pureref:adversarial": "playwright test --config tests/pureref/playwright.config.mjs adversarial.spec.mjs",
		"test:pureref:report": "playwright show-report",
		"preview:pureref": "node scripts/pureref-preview.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@fontsource-variable/open-sans": "5.3.0",
		"@playwright/test": "1.63.0",
		"@types/node": "^16.11.6",
		"@types/pdfjs-dist": "^2.10.378",
		"@types/sql.js": "^1.4.9",
		"@types/three": "^0.172.0",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.0",
		"obsidian": "latest",
		"obsidian-typings": "^2.11.1",
		"tslib": "2.4.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@panzoom/panzoom": "4.6.2",
		"@webtoon/psd": "^0.4.0",
		"@zip.js/zip.js": "^2.6.40",
		"pur-2-file-format": "git+https://github.com/Vacyyyy/pur-2-file-format.git#d287a4e92081caa8723b939240e9435856190f7a",
		"sql.js": "^1.13.0",
		"three": "^0.172.0"
	}
}
